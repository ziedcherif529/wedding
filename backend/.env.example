APP_NAME=SmartLife
APP_ENV=development
DEBUG=true
# Replace CHANGE_ME with the password configured for local PostgreSQL on port 5432.
DATABASE_URL=postgresql+pg8000://postgres:CHANGE_ME@localhost:5432/smartlife_db
JWT_SECRET_KEY=smartlife-dev-secret-key-change-me-for-production-32+
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200
